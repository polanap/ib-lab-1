# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=iblab1
PG_USERNAME=iblab1
PG_PASSWORD=change-me

# Must be at least 256 bits (32+ characters) for HS256 signing.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
